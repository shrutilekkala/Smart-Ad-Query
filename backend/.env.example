# Optional: enables LLM-generated RAG answers via the Anthropic API.
# Without this set, /api/query falls back to a deterministic extractive answer.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown are relative to backend/data/)
# DATABASE_URL=sqlite:///backend/data/ads.db
# EMBEDDING_BACKEND=tfidf  # or "sentence-transformers"
